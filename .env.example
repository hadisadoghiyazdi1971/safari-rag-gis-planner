# Copy this file to .env and fill in your own credentials.
# Never commit the real .env file.

# API key for OpenRouter (https://openrouter.ai), used for LLM caption
# enrichment (src/rag/llm_enhancer.py) and itinerary narrative generation
# (src/optimization/interactive_safari_storyteller.py).
OPENROUTER_API_KEY=

# Model routed through OpenRouter. Default used in the reported experiments:
OPENROUTER_MODEL=openai/gpt-4o-mini
